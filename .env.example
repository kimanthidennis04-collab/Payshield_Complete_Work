# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite for local development, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production Database URL example:
# DATABASE_URL="postgresql://username:password@localhost:5432/payshield?schema=public"

# Authentication & Security
JWT_SECRET=your-strong-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Payment Providers (Safaricom Daraja API)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=YOUR_SAFARICOM_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_SAFARICOM_DARAJA_CONSUMER_SECRET
MPESA_PASSKEY=YOUR_SAFARICOM_LIPA_NA_MPESA_ONLINE_PASSKEY
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/webhooks/mpesa
APP_URL=http://localhost:3000

# Meta WhatsApp Cloud API (https://developers.facebook.com/apps/)
WHATSAPP_ACCESS_TOKEN=YOUR_META_WHATSAPP_PERMANENT_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_META_BUSINESS_ACCOUNT_ID
WHATSAPP_API_VERSION=v19.0

# Card Processing (Optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Messaging & Reminders (Optional - simulated in development)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email / SMTP Delivery (Optional - simulated in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@payshield.com

# AI / Copilot Integration (Optional - rule engine active by default)
OPENAI_API_KEY=
AI_PROVIDER_KEY=
AI_PROVIDER_ENDPOINT=
