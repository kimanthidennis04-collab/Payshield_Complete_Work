# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite for local development, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production Database URL example:
# DATABASE_URL="postgresql://username:password@localhost:5432/payshield?schema=public"

# Authentication & Security
JWT_SECRET=your-strong-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Payment Providers (Optional - for live provider integration)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=

# Card Processing (Optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Messaging & Reminders (Optional - simulated in development)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email / SMTP Delivery (Optional - simulated in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@payshield.com

# AI / Copilot Integration (Optional - rule engine active by default)
OPENAI_API_KEY=
AI_PROVIDER_KEY=
AI_PROVIDER_ENDPOINT=
