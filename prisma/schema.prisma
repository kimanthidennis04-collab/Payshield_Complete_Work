generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  country   String?
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  services      Service[]
  quotes        Quote[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  transactions  Transaction[]
  webhookLogs   WebhookLog[]
  aiInsights    AIInsight[]
  auditLogs     AuditLog[]
  deliverables  Deliverable[]
  properties    Property[]
  tenants       Tenant[]
  tenancies     Tenancy[]
  rentInvoices  RentInvoice[]
  rentPayments  RentPayment[]

  @@index([country])
  @@index([currency])
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String   @unique
  password       String
  role           String   @default("STAFF")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@index([organizationId])
  @@index([email])
}

model Client {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotes       Quote[]
  invoices     Invoice[]

  @@index([organizationId])
  @@index([email])
}

model Service {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  price          Float
  currency       String   @default("USD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteItems   QuoteItem[]
  invoiceItems InvoiceItem[]

  @@index([organizationId])
}

model Quote {
  id             String    @id @default(uuid())
  organizationId String
  clientId       String
  quoteNumber    String    @unique
  status         String    @default("DRAFT")
  subtotal       Float     @default(0)
  tax            Float     @default(0)
  total          Float     @default(0)
  notes          String?
  validUntil     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items        QuoteItem[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([quoteNumber])
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  serviceId   String?
  description String
  quantity    Float
  unitPrice   Float
  total       Float

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([serviceId])
}

model Invoice {
  id             String    @id @default(uuid())
  organizationId String
  clientId       String
  invoiceNumber  String    @unique
  status         String    @default("DRAFT")
  subtotal       Float     @default(0)
  tax            Float     @default(0)
  total          Float     @default(0)
  amountPaid     Float     @default(0)
  balance        Float     @default(0)
  currency       String    @default("USD")
  dueDate        DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items        InvoiceItem[]
  payments     Payment[]
  transactions Transaction[]
  deliverables Deliverable[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([dueDate])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Float
  unitPrice   Float
  total       Float

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([serviceId])
}

model Payment {
  id             String    @id @default(uuid())
  organizationId String
  invoiceId      String
  amount         Float
  currency       String    @default("USD")
  method         String
  provider       String    @default("OTHER")
  reference      String?
  status         String    @default("PENDING")
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([organizationId])
  @@index([invoiceId])
  @@index([status])
  @@index([paidAt])
}

model Expense {
  id             String   @id @default(uuid())
  organizationId String
  category       String
  description    String
  amount         Float
  currency       String   @default("USD")
  date           DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([category])
  @@index([date])
}

model Transaction {
  id             String   @id @default(uuid())
  organizationId String
  type           String
  amount         Float
  currency       String   @default("USD")
  source         String
  reference      String?
  status         String   @default("PENDING")
  invoiceId      String?
  paymentId      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([createdAt])
}

model WebhookLog {
  id             String   @id @default(uuid())
  organizationId String?
  provider       String
  event          String
  reference      String?
  payload        String
  status         String   @default("RECEIVED")
  error          String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([provider])
  @@index([event])
  @@index([status])
  @@index([reference])
}

model AIInsight {
  id             String   @id @default(uuid())
  organizationId String
  type           String
  title          String
  content        String
  severity       String   @default("INFO")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Deliverable {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  name           String
  filePath       String
  fileSize       Int
  fileType       String
  isProtected    Boolean  @default(true)
  isUnlocked     Boolean  @default(false)
  unlockedAt     DateTime?
  unlockedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([isProtected])
  @@index([isUnlocked])
}

model PaymentReminder {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  scheduledFor   DateTime
  sentAt         DateTime?
  status         String   @default("PENDING")
  method         String
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
  @@index([scheduledFor])
  @@index([status])
}

model Property {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String?
  propertyType   String
  totalUnits     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units         PropertyUnit[]

  @@index([organizationId])
  @@index([propertyType])
}

model PropertyUnit {
  id             String   @id @default(uuid())
  organizationId String
  propertyId     String
  unitNumber     String
  size           Float?
  rentAmount     Float
  currency       String   @default("USD")
  status         String   @default("AVAILABLE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenancies Tenancy[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
}

model Tenant {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  idNumber       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenancies   Tenancy[]

  @@index([organizationId])
  @@index([email])
}

model Tenancy {
  id             String   @id @default(uuid())
  organizationId String
  propertyUnitId String
  tenantId       String
  startDate      DateTime
  endDate        DateTime?
  rentAmount     Float
  currency       String   @default("USD")
  depositAmount  Float?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyUnit   PropertyUnit   @relation(fields: [propertyUnitId], references: [id], onDelete: Cascade)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentInvoices   RentInvoice[]

  @@index([organizationId])
  @@index([propertyUnitId])
  @@index([tenantId])
  @@index([status])
}

model RentInvoice {
  id             String   @id @default(uuid())
  organizationId String
  tenancyId      String
  invoiceNumber  String    @unique
  rentPeriod     String
  dueDate        DateTime
  amount         Float
  currency       String   @default("USD")
  status         String    @default("PENDING")
  amountPaid     Float     @default(0)
  balance        Float
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenancy      Tenancy      @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  payments     RentPayment[]

  @@index([organizationId])
  @@index([tenancyId])
  @@index([status])
  @@index([dueDate])
}

model RentPayment {
  id             String   @id @default(uuid())
  organizationId String
  rentInvoiceId  String
  amount         Float
  currency       String   @default("USD")
  method         String
  reference      String?
  paidAt         DateTime?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rentInvoice  RentInvoice  @relation(fields: [rentInvoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([rentInvoiceId])
  @@index([status])
}


